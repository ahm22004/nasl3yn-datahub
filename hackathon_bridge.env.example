# Hackathon Discovery Bridge Config
# Copy to .env and fill in

# HTTP proxy for blocked sources (optional)
# HACKATHON_SCRAPER_PROXY=http://your-proxy:8080

# Cache TTL in seconds (default: 3600 = 1 hour)
SCAN_CACHE_TTL_SECONDS=3600

# Cloudflare Tunnel token for managed tunnel (optional)
# CLOUDFLARE_TUNNEL_TOKEN=your-token-here

# Scanner script path (default: ~/.hermes/scripts/hackathon_weekly.py)
# SCANNER_SCRIPT=/home/ahm/.hermes/scripts/hackathon_weekly.py

# Reports directory (default: ~/.hermes/reports/hackathons)
# REPORTS_DIR=/home/ahm/.hermes/reports/hackathons

# Bind address/port (default: 127.0.0.1:8888)
# HOST=127.0.0.1
# PORT=8888